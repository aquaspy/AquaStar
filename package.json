{
  "name": "AquaStar",
  "version": "2.1.0",
  "description": "Experimental AquaStar launcher that plays Adventure Quest Worlds with the Ruffle web player",
  "homepage": "https://github.com/aquaspy/AquaStar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist-w": "electron-builder -w --publish never",
    "dist-l": "electron-builder -l --publish never",
    "dist-wl": "electron-builder -wl --publish never",
    "dist-m": "electron-builder -m --publish never",
    "loc": "node scripts/count-loc.js",
    "web:build": "node scripts/build-web.js",
    "web:preview": "npm run web:build && node scripts/serve-web.js",
    "lint": "eslint main.js res scripts test \"plugins/*/web/**/*.js\" --ext .js",
    "format": "prettier --write package.json .github .eslintrc.cjs .prettierrc.json \"plugins/*/web/**/*\" scripts/build-web.js scripts/serve-web.js test",
    "format:check": "prettier --check package.json .github .eslintrc.cjs .prettierrc.json \"plugins/*/web/**/*\" scripts/build-web.js scripts/serve-web.js test",
    "test": "node test/run.js",
    "smoke:plugins": "node scripts/smoke-plugins.js",
    "test:ci": "npm run test && npm run smoke:plugins && npm run pack"
  },
  "keywords": [
    "aqw;",
    "aquastar;",
    "aqlite;"
  ],
  "author": "aquastar",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3"
  },
  "build": {
    "publish": null,
    "asar": true,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "files": [
      "**/*",
      "!squashfs-root/**",
      "!docs/**",
      "!test/**",
      "!ruffle/**",
      "!scripts/**",
      "!**/*.map",
      "!**/*.md",
      "!**/.cursor/**",
      "!**/.github/**",
      "!**/.eslintrc.cjs",
      "!**/.prettierrc.json",
      "!**/.prettierignore"
    ],
    "appId": "io.github.aquaspy.aquastar",
    "afterPack": "./scripts/strip-mac-signature.js",
    "mac": {
      "identity": null,
      "category": "public.app-category.games",
      "artifactName": "AquaStar-${version}-mac-x64.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "AquaStar captures the game window for screenshots and recordings."
      },
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "aquastar",
      "synopsis": "AQW launcher using the Ruffle web player",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "icon": "Icon/Icon.png"
  },
  "dependencies": {
    "electron-localshortcut": "3.2.1",
    "gifenc": "^1.0.3",
    "ws": "^8.21.1",
    "yauzl": "^2.10.0"
  }
}
