{
  "format": "aquastar-desktop-plugin",
  "apiVersion": 2,
  "id": "adventure-quest-worlds",
  "name": "Adventure Quest Worlds",
  "version": "1.0.0",
  "description": "AdventureQuest Worlds and DragonFable, with the inventory, reminders, to-do and strategy tools.",
  "launcherParameters": { "id": "aqw", "defaultGame": "aqw" },
  "games": [
    {
      "id": "aqw",
      "name": "AdventureQuest Worlds",
      "description": "Opens the game in its own window.",
      "resolver": "aqw-primary",
      "engines": [{ "engine": "ruffle", "default": true }, { "engine": "flash" }]
    },
    {
      "id": "dragonfable",
      "name": "DragonFable",
      "description": "Opens the game in its own window.",
      "resolver": "dragonfable",
      "engines": [{ "engine": "ruffle", "default": true }, { "engine": "flash" }]
    }
  ],
  "tools": [
    { "id": "inventory", "name": "Inventory & Buy Back", "builtin": "inventory" },
    { "id": "reminders", "name": "Reminders", "builtin": "reminders" },
    { "id": "todo", "name": "To-Do List", "builtin": "todo" },
    { "id": "strategy", "name": "Strategy", "builtin": "strategy" },
    { "id": "studio", "name": "Char Page Studio", "builtin": "studio" }
  ],
  "searches": [
    {
      "id": "wiki",
      "name": "AQW Wiki",
      "placeholder": "Item name…",
      "urlTemplate": "https://aqwwiki.wikidot.com/search:site/q/{q}"
    },
    {
      "id": "charpage",
      "name": "Character page",
      "placeholder": "Character name",
      "urlTemplate": "https://account.aq.com/CharPage?id={q}",
      "sanitize": "alphanumeric"
    }
  ],
  "launcher": {
    "blocks": [
      { "type": "games" },
      { "type": "tools", "title": "Your tools" },
      { "type": "search", "title": "Looking for an item?", "items": ["wiki"] },
      { "type": "links", "title": "Useful Pages", "source": "menu:useful" },
      { "type": "search", "title": "Character page", "items": ["charpage"] }
    ]
  }
}
