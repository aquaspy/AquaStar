{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AquaStar Lite",
  "version": "0.1.0",
  "identifier": "io.github.aquaspy.aquastar-lite",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "AquaStar Lite", "width": 900, "height": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": ["icons/icon.png"]
  }
}
