+pub struct LayeredPropertyMap<'gc, V: 'gc> {
+    own: PropertyMap<'gc, V>,
+    base: Option<Gc<'gc, PropertyMap<'gc, V>>>,
+    /// The local names in `own` that `base` doesn't have, in the order they
