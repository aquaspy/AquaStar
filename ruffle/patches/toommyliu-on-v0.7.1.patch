+            PosUvVertex::new(0.0, 0.0, u0, v0, 1.0),
+            PosUvVertex::new(1.0, 0.0, u1, v0, 1.0),
+            PosUvVertex::new(1.0, 1.0, u1, v1, 1.0),
+            PosUvVertex::new(0.0, 1.0, u0, v1, 1.0),
