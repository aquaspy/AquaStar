+            assert_eq!(drawn_x(update, item, 1, 0.5), [0.0]);
+            item.set_parent(update, Some(second.into()));
+            item.set_x(Twips::from_pixels_i32(10));
+            assert_eq!(drawn_x(update, item, 2, 0.5), [10.0]);
+        });
+    }
+}
