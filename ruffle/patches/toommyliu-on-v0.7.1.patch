+fn filter_into_cache(
+    descriptors: &Descriptors,
+    scope: &mut Scope<'_, wgpu::CommandEncoder>,
+    texture_pool: &mut TexturePool,
+    staging_belt: &mut wgpu::util::StagingBelt,
+    source: FilterSource,
+    filters: Vec<Filter>,
+    cache: &Texture,
