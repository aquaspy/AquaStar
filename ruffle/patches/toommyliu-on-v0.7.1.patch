@@ -0,0 +1,19 @@
+package {
+    import flash.display.MovieClip;
+
+    public class Part extends MovieClip {
+        public static var throwing:Boolean = false;
+        private static var thrown:int = 0;
+
+        public function Part() {
+            addFrameScript(0, frame1);
+        }
+
+        private function frame1():void {
+            if (throwing) {
+                thrown++;
+                throw new Error("child frame script " + thrown);
+            }
+        }
+    }
+}
diff --git a/tests/tests/swfs/avm2/uncaught_error_events_collected_loader/Test.as b/tests/tests/swfs/avm2/uncaught_error_events_collected_loader/Test.as
new file mode 100644
